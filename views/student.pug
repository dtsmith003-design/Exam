extends layout

block content
  h1 Student Dashboard

  h2 Welcome, #{studentName}

  h3 Your Enrolled Courses

  if enrollments && enrollments.length > 0
    table(border="1")
      thead
        tr
          th Course Number
          th Term
          th Year
          th Instructor
          th Grade
      tbody
        each item in enrollments
          tr
            td= item.CourseNo
            td= item.OffTerm
            td= item.OffYear
            td= item.Instructor
            td= item.EnrGrade
  else
    p No enrolled courses found.

  h3 Winter 2026 Course Offerings

  if offerings && offerings.length > 0
    table(border="1")
      thead
        tr
          th Course Number
          th Instructor
          th Location
          th Time
          th Days
          th Enrolled
          th Action
      tbody
        each item in (offerings)
          tr
            td= item.CourseNo
            td= item.Instructor
            td= item.OffLocation
            td= item.OffTime
            td= item.OffDays
            td= item.Enrolled
            td
              if item.Enrolled === 'Yes'
                form(action="/student/drop" method="post")
                  input(type="hidden" name="ID" value=studentID)
                  input(type="hidden" name="OfferNo" value=item.OfferNo)
                  button(type="submit") Drop
              else
                form(action="/student/add" method="post")
                  input(type="hidden" name="ID" value=studentID)
                  input(type="hidden" name="OfferNo" value=item.OfferNo)
                  button(type="submit") Add
  else
    p No course offerings found.

  p
    a(href="/") Back to Home